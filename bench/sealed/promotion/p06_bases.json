{
 "id": "p06_bases",
 "title": "Number base converter",
 "request": "Number base converter. 'hex <decimal>' replies '0x<lowercase hex>'. 'dec <hex>' (with or without 0x) replies the decimal value. 'bin <decimal>' replies '0b<binary>'. Invalid input replies 'error: invalid number'.",
 "tests": [
