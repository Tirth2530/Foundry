       "type": "ack"
      },
      {
       "type": "text_contains",
       "value": "base64: aGVsbG8gd29ybGQ=",
       "ci": false
      }
     ]
    }
   ]
  },
  {
   "name": "decode",
   "turns": [
    {
     "send": "decode RmV0Y2guYWk=",
     "checks": [
      {
       "type": "text_contains",
       "value": "text: Fetch.ai",
       "ci": false
      }
     ]
    }
   ]
  },
  {
   "name": "invalid",
   "turns": [
    {
     "send": "decode !!!notbase64",
     "checks": [
      {
       "type": "text_contains",
