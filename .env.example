# --- Fetch.ai -------------------------------------------------------------
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=
FOUNDRY_SEED=replace-with-a-long-random-secret-string
FOUNDRY_PORT=8000
# split (default) | bureau | direct
FOUNDRY_NETWORK_MODE=split

# --- Builder: GPT ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# USD per 1M tokens for the model above (used for metered cost)
OPENAI_PRICE_IN=1.25
OPENAI_PRICE_OUT=10.0

# --- Independent verifier: Meta Llama (OpenAI-compatible endpoint) ---------
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.meta.ai/v1
LLAMA_MODEL=muse-spark-1.1
LLAMA_PRICE_IN=0.27
LLAMA_PRICE_OUT=0.85

# --- ASI:One LLM (Foreman + Architect) ------------------------------------
ASI_MODEL=asi1

# --- Optional: Stripe TEST mode for the Payment Protocol -------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Build loop -------------------------------------------------------------
FOUNDRY_BUDGET_USD=1.50
FOUNDRY_PARALLEL=2
FOUNDRY_TURN_TIMEOUT=15
FOUNDRY_ADMINS=
FOUNDRY_LEARN_PER_DAY=3
# docker (recommended for paid runs: refuses to run without the sandbox) | auto | process
FOUNDRY_SANDBOX=docker
