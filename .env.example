# --- Fetch.ai -------------------------------------------------------------
AGENTVERSE_API_KEY=
ASI_ONE_API_KEY=
FOUNDRY_SEED=replace-with-a-long-random-secret-string
FOUNDRY_PORT=8000
# split (default) | bureau | direct
FOUNDRY_NETWORK_MODE=split

# --- Builder: GPT ---------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# full-quality reasoning for building/repairing code (low = faster/cheaper, high = slowest)
OPENAI_REASONING_EFFORT=medium
# USD per 1M tokens for the model above (used for metered cost)
OPENAI_PRICE_IN=1.25
OPENAI_PRICE_OUT=10.0

# --- Independent verifier: Meta Llama (OpenAI-compatible endpoint) ---------
LLAMA_API_KEY=
LLAMA_BASE_URL=https://api.meta.ai/v1
LLAMA_MODEL=muse-spark-1.1
LLAMA_PRICE_IN=0.27
LLAMA_PRICE_OUT=0.85

# --- ASI:One LLM (Foreman + Architect) ------------------------------------
ASI_MODEL=asi1

# --- Optional: Stripe TEST mode for the Payment Protocol -------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Build loop -------------------------------------------------------------
FOUNDRY_BUDGET_USD=1.50
FOUNDRY_PARALLEL=3
FOUNDRY_TURN_TIMEOUT=15
FOUNDRY_ADMINS=
FOUNDRY_LEARN_PER_DAY=3
# REQUIRED: process (isolated child process, EMPTY env so no API keys, rlimits, static gate) | docker (hardened container)
FOUNDRY_SANDBOX=process
# Sealed promotion/final sets run in process mode only with a logged reason (Docker gives stronger isolation):
FOUNDRY_ALLOW_PROCESS_SANDBOX_FOR_SEALED=static gate forbids file/env/os access; Docker not used for this run

# --- Spend ceilings (USD). Empty = no ceiling at that level. --------------
# Total model spend ever allowed for this deployment (persisted in evidence/usage.db across restarts)
FOUNDRY_PROJECT_CAP_USD=60
# Per provider (optional)
FOUNDRY_PROVIDER_CAP_USD_GPT=
FOUNDRY_PROVIDER_CAP_USD_META=
FOUNDRY_PROVIDER_CAP_USD_ASI=
# Hard ceiling for one `learn` run (learn-from-build + sealed promotion evaluation)
FOUNDRY_LEARN_MAX_USD=10
# How long the publisher polls the Agentverse search index before reporting DEPLOYED (not yet discoverable)
FOUNDRY_DISCOVERY_WAIT_S=120
